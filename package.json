{
  "name": "@frac/monorepo",
  "version": "0.0.0",
  "description": "Frac is a framework for building ChatGPT and MCP Apps",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter frac build && pnpm --filter create-frac build",
    "test": "pnpm run test:unit && pnpm run test:format",
    "format": "pnpm --filter frac format && pnpm --filter create-frac format",
    "test:unit": "pnpm --filter frac test:unit && pnpm --filter create-frac test:unit",
    "test:format": "pnpm --filter frac test:format && pnpm --filter create-frac test:format",
    "docs:dev": "pnpm --dir docs dev"
  },
  "keywords": [
    "chatgpt",
    "app",
    "ai",
    "frac"
  ],
  "author": "Frédéric Barthelet",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^24.12.0",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "overrides": {
      "frac": "workspace:*",
      "@mintlify/prebuild>js-yaml": "^4.1.1",
      "@mintlify/previewing>js-yaml": "^4.1.1",
      "@mintlify/scraping>js-yaml": "^4.1.1",
      "@mintlify/validation>js-yaml": "^4.1.1",
      "@openai/apps-sdk-ui>lodash": "^4.17.23",
      "@mintlify/cli>js-yaml": "^4.1.1",
      "@mintlify/common>js-yaml": "^4.1.1",
      "@mintlify/common>lodash": "^4.17.23",
      "@mintlify/models>axios": "^1.13.5",
      "@mintlify/previewing>express": "^4.20.0",
      "@mintlify/scraping>zod": "3.24.0",
      "@mintlify/validation>lodash": "^4.17.23",
      "@mintlify/validation>zod": "3.24.0",
      "@stoplight/spectral-core>minimatch": "^10.2.3",
      "@vitest/ui>flatted": "^3.4.2",
      "@workos-inc/node>qs": "^6.14.2",
      "engine.io>cookie": "^0.7.0",
      "iron-session>cookie": "^0.7.0"
    }
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.1"
  }
}
